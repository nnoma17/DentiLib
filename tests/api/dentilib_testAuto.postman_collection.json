	"item": [
		{
			"name": "CREATE ADMIN",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const statusCode = pm.response.code;",
							"const reponse = pm.response.json();",
							"const data = pm.iterationData;",
							"",
							"pm.test(\"La réponse est du JSON\", () => pm.response.to.be.json);",
							"",
							"if (statusCode === 201) {",
							"    pm.test(\"message et user présents, sans mot de passe\", () => {",
							"        pm.expect(reponse).to.have.property(\"message\");",
							"        pm.expect(reponse).to.have.property(\"user\");",
							"        pm.expect(reponse.user).to.not.have.property(\"password\");",
							"    });",
							"}",
							"",
							"if (statusCode === 409) {",
							"    pm.test(\"Email déjà utilisé\", () => {",
							"        pm.expect(reponse.message).to.eql(\"Email déjà utilisé\");",
							"    });",
							"}",
							"",
							"if (statusCode === 400) {",
							"    if (!data.get(\"emailCreation\") || !data.get(\"passwordCreation\")) {",
							"        pm.test(\"Champs manquants\", () => {",
							"            pm.expect(reponse.message).to.eql(\"Champs manquants\");",
							"        });",
							"    } else if (data.get(\"passwordCreation\").length < 6) {",
							"        pm.test(\"Mot de passe trop court\", () => {",
							"            pm.expect(reponse.message).to.eql(\"Mot de passe trop court\");",
							"        });",
							"    }",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"console.log(\"avant\");"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{tokenAdmin}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"firstName\": \"{{firstName}}\",\r\n  \"lastName\": \"{{lastName}}\",\r\n  \"email\": \"{{emailCreation}}\",\r\n  \"password\": \"{{passwordCreation}}\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{BASE_URL}}/api/admin/create_Admin",
					"host": [
						"{{BASE_URL}}"
					],
					"path": [
						"api",
						"admin",
						"create_Admin"
					]
				}
			},
			"response": []
		},
		{
			"name": "LOGIN",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const statusCode = pm.response.code;",
							"const reponse = pm.response.json();",
							"",
							"pm.test(\"La réponse est du JSON\", () => pm.response.to.be.json);",
							"",
							"if (statusCode === 200) {",
							"    pm.environment.set(\"tokenAdmin\", reponse.token);",
							"    pm.test(\"Token présent, sans mot de passe dans la réponse\", () => {",
							"        pm.expect(reponse).to.have.property(\"token\");",
							"        pm.expect(reponse.user).to.not.have.property(\"password\");",
							"    });",
							"}",
							"",
							"if (statusCode === 401) {",
							"    pm.test(\"Message unique pour email ou mot de passe incorrect\", () => {",
							"        pm.expect(reponse.message).to.eql(\"Identifiant incorrect\");",
							"    });",
							"}",
							"",
							"if (statusCode === 400) {",
							"    pm.test(\"Champs manquants\", () => {",
							"        pm.expect(reponse.message).to.eql(\"Champs manquants\");",
							"    });",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"email\": \"{{emailLogin}}\",\r\n  \"password\": \"{{passwordLogin}}\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{BASE_URL}}/api/user/login_User",
					"host": [
						"{{BASE_URL}}"
					],
					"path": [
						"api",
						"user",
						"login_User"
					]
				}
			},
			"response": []
		},
